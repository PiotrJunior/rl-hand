{
  "device": "mps",
  "mode": null,
  "env": {
    "name": "real_robot",
    "fps": 30,
    "robot": {
      "type": "mujoco_orca"
    },
    "teleop": {
      "type": "keyboard_wasd"
    },
    "processor": {
      "observation": {
        "display_cameras": true,
        "add_joint_velocity_to_observation": false,
        "add_current_to_observation": false,
        "add_ee_pose_to_observation": false
      },
      "gripper": {
        "use_gripper": false,
        "gripper_penalty": 0.0
      },
      "reset": {
        "control_time_s": 10.0,
        "terminate_on_success": true
      }
    }
  }
}