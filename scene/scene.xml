<?xml version="1.0" ?>
<mujoco model="ORCA hand right scene">

  <include file="models/assets/scene.xml"/>
  <include file="models/assets/options.xml"/>
  <include file="models/mjcf/orcahand_right.mjcf"/>

  <worldbody>
    <camera name="base" pos="0 -0.5 0.5" xyaxes="1 0 0 0 1 1" fovy="60"/>

    <body name="ball" pos="-0.15 0.0 0.1">
      <freejoint name="ball_joint"/>
      <geom type="sphere" size="0.05" rgba="1 0 0 1" condim="3" friction="1 0.005 0.0001"/>
    </body>

    <body name="hand_base_xyz" pos="0.15 0 0.25" gravcomp="1">
      <joint name="slide_x" type="slide" axis="1 0 0" limited="true" range="-1 1" damping="1"/>
      <joint name="slide_y" type="slide" axis="0 1 0" limited="true" range="-1 1" damping="1"/>
      <joint name="slide_z" type="slide" axis="0 0 1" limited="true" range="-.5 1" damping="1"/>
      
      <body name="right_mount" pos="0 0 0" euler="-0.3 0 0">
        <camera name="wrist" pos="0 0.1 -0.08" euler="1.2 0 0" fovy="70"/>
        
        <include file="models/mjcf/orcahand_right_body.xml"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="move_x" joint="slide_x" kp="100" kv="10" ctrlrange="-1 1" forcelimited="false"/>
    <position name="move_y" joint="slide_y" kp="100" kv="10" ctrlrange="-1 1" forcelimited="false"/>
    <position name="move_z" joint="slide_z" kp="100" kv="10" ctrlrange="-0.5 1" forcelimited="false"/>
  </actuator>

</mujoco>